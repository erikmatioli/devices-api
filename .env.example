# Copy to .env for `make run`. Every variable is optional except DATABASE_URL.

DATABASE_URL=postgres://devices:devices@localhost:5432/devices?sslmode=disable
# DATABASE_MAX_CONNS=10
# DATABASE_MIN_CONNS=2
# DATABASE_CONNECT_TIMEOUT=5s
# DATABASE_AUTO_MIGRATE=true

# Access tokens. Use AUTH_JWKS_URL (and no secret) with a real identity
# provider; the shared secret is for local development and must match the
# one used to mint tokens (make token). It must be at least 32 bytes.
AUTH_ISSUER=devices-api-local
AUTH_AUDIENCE=devices-api
AUTH_HS256_SECRET=local-development-secret-change-me
# AUTH_JWKS_URL=https://idp.example.org/.well-known/jwks.json
# AUTH_JWKS_REFRESH=15m
# AUTH_CLOCK_SKEW=30s

# Idempotency-Key records. The lock timeout must exceed HTTP_WRITE_TIMEOUT.
# IDEMPOTENCY_TTL=24h
# IDEMPOTENCY_LOCK_TIMEOUT=1m
# IDEMPOTENCY_PURGE_INTERVAL=15m

# Event stream limits per replica.
# EVENTS_MAX_SUBSCRIBERS=1000
# EVENTS_SUBSCRIBER_BUFFER=64

# HTTP_ADDR=:8080
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_IDLE_TIMEOUT=60s
# SHUTDOWN_TIMEOUT=15s

# Log level: debug, info, warn or error.
# LOG_LEVEL=info
# Log format: json or text.
LOG_FORMAT=text

# Host ports published by `docker compose`.
# API_PORT=8080
# POSTGRES_PORT=5432
