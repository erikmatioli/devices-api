{
  "uid": "devices-api-overview",
  "title": "Devices API · Service overview",
  "description": "Service level, traffic, latency and errors of the Devices API.",
  "tags": [
    "devices-api"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"devices-api\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"devices-api\"}, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Domain and dependencies",
      "type": "link",
      "url": "/d/devices-api-domain",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    },
    {
      "title": "Traces (Jaeger)",
      "type": "link",
      "url": "http://localhost:16686/search?service=devices-api",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "tags": [],
      "keepTime": false,
      "includeVars": false
    },
    {
      "title": "Alerts (Prometheus)",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "tags": [],
      "keepTime": false,
      "includeVars": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Service level objectives",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Objectives** on the `/v1` API, event stream excluded: **99.9%** of requests without a 5xx and **99%** within **500 ms**. The first three panels cover the selected time range; the alert rules evaluate the same objectives over 5 minutes to 6 hours."
      },
      "transparent": true,
      "id": 2,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Availability",
      "description": "Share of API requests answered without a 5xx status over the selected range. Objective: 99.9%.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\", http_response_status_code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\"}[$__range]))",
          "legendFormat": "availability",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.995
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Latency SLI",
      "description": "Share of API requests completed within 500 ms over the selected range. Objective: 99%.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_request_duration_seconds_bucket{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\", le=\"0.5\"}[$__range])) / sum(increase(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\"}[$__range]))",
          "legendFormat": "fast",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Budget left",
      "description": "Part of the availability budget (0.1% of requests) not yet spent over the selected range. Below zero means the objective was missed.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\", http_response_status_code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\"}[$__range]))) / 0.001",
          "legendFormat": "budget",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 5,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Requests/s",
      "description": "API requests per second, all routes.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\"}[$__rate_interval]))",
          "legendFormat": "rps",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 6,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile of API request duration.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 7,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "5xx ratio",
      "description": "Share of API requests failing with 5xx right now.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"devices-api\", instance=~\"$instance\", http_route=~\"[A-Z]+ /v1/.+\", http_route!=\"GET /v1/devices/events\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
