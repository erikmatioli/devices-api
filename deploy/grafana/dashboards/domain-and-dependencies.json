      "title": "Devices created and deleted",
      "description": "Committed creations and deletions per minute.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(devices_created_total{job=\"devices-api\", instance=~\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "created",
          "refId": "A",
          "range": true,
          "instant": false
