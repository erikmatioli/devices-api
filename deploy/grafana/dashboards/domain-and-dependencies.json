        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(devices_events_dropped_subscribers_total{job=\"devices-api\", instance=~\"$instance\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "dropped",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
