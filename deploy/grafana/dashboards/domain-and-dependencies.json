{
  "uid": "devices-api-domain",
  "title": "Devices API · Domain and dependencies",
  "description": "Device inventory and lifecycle, idempotency, event streams, database and Go runtime.",
  "tags": [
    "devices-api"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
